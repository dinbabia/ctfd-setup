# Use long, alphanumeric values so the database password is safe in a connection URL.
MARIADB_ROOT_PASSWORD=replace-with-a-long-random-value
CTFD_DB_PASSWORD=replace-with-a-different-long-random-value
CTFD_SECRET_KEY=replace-with-a-long-random-secret-key
FLAG1=CTF{replace_with_a_unique_flag_1}
FLAG2=CTF{replace_with_a_unique_flag_2}
FLAG3=CTF{replace_with_a_unique_flag_3}
FLAG4=CTF{replace_with_a_unique_flag_4}
FLAG5=CTF{replace_with_a_unique_flag_5}
DOTNET_ADMIN_USERNAME=replace-with-dotnet-admin-username
DOTNET_ADMIN_PASSWORD=replace-with-dotnet-admin-password
ADVENTURER_PASSWORD=replace-with-guest-password
WARRIOR_PASSWORD=replace-with-employee-password
LEGEND_PASSWORD=replace-with-administrator-password
